[submodule "telegraf"]
	path = future-support/telegraf/telegraf
	url = https://github.com/influxdata/telegraf.git
	branch = release-1.37
[submodule "opentelemetry-go"]
	path = opentelemetry-go
	url = https://github.com/open-telemetry/opentelemetry-go.git
[submodule "opentelemetry-proto"]
	path = opentelemetry-proto
	url = https://github.com/open-telemetry/opentelemetry-proto.git
[submodule "opentelemetry-collector"]
	path = opentelemetry-collector
	url = https://github.com/open-telemetry/opentelemetry-collector.git
	branch = release/v0.141.x
[submodule "opentelemetry-collector-contrib"]
	path = opentelemetry-collector-contrib
	url = https://github.com/open-telemetry/opentelemetry-collector-contrib.git
	branch = release/v0.141.0
[submodule "otel-arrow"]
	path = future-support/otap/otel-arrow
	url = https://github.com/open-telemetry/otel-arrow.git

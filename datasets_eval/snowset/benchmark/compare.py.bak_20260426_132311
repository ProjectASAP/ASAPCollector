from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path
from typing import Callable

BENCH_ROOT = Path(__file__).resolve().parent
if str(BENCH_ROOT) not in sys.path:
    sys.path.insert(0, str(BENCH_ROOT))

import numpy as np
import pandas as pd
import pyarrow.dataset as ds

from common import PARQUET_PATH

# Maps query → regex matching its sketch metric in Prometheus scrape CSVs.
_SKETCH_METRIC_PATTERN: dict[str, str] = {
    "Q1": r"countsketch|countminsketch",
    "Q2": r"kll|_p99$",
    "Q3": r"_ddsketch",
    "Q4": r"countsketch|countminsketch",
    "Q5": r"_hll_cardinality",
    "Q6": r"kll|_p95$|_p99$",
}

HEAVY_HITTER_PHI = 0.10   # Q1: warehouse is a heavy hitter if freq >= 10% of fleet total
DEFAULT_ACCURACY_THRESHOLD = 0.5


def _series_to_ns(ts_series: pd.Series) -> np.ndarray:
    return ts_series.astype(np.int64).to_numpy(dtype=np.int64)


def _q2_prefix_gt_map(max_data_minutes: float, chunksize: int = 200_000) -> dict[str, float]:
    dataset = ds.dataset(str(PARQUET_PATH), format="parquet")
    cols = ["createdTime", "warehouseId", "durationTotal"]
    min_ns: int | None = None

    for batch in dataset.to_batches(batch_size=chunksize, columns=cols):
        df = batch.to_pandas()
        df = df[df["durationTotal"] > 0]
        if df.empty:
            continue
        batch_min = int(_series_to_ns(df["createdTime"]).min())
        if min_ns is None or batch_min < min_ns:
            min_ns = batch_min

    if min_ns is None:
        return {}

    cutoff_ns = min_ns + int(max_data_minutes * 60 * 1e9)
    parts: list[pd.DataFrame] = []
    for batch in dataset.to_batches(batch_size=chunksize, columns=cols):
        df = batch.to_pandas()
        if df.empty:
            continue
        ts_ns = _series_to_ns(df["createdTime"])
        mask = (df["durationTotal"].to_numpy(dtype=np.float64) > 0) & (ts_ns <= cutoff_ns)
        if not np.any(mask):
            continue
        part = df.loc[mask, ["warehouseId", "durationTotal"]].copy()
        part["warehouseId"] = part["warehouseId"].astype(str)
        parts.append(part)

    if not parts:
        return {}
    prefix = pd.concat(parts, ignore_index=True)
    return {
        str(wh): float(np.percentile(grp["durationTotal"].to_numpy(dtype=np.float64), 99))
        for wh, grp in prefix.groupby("warehouseId")
    }


def _latest_snapshot(df: pd.DataFrame) -> pd.DataFrame:
    if df.empty:
        return df
    wall = pd.to_numeric(df["scrape_wall_ns"], errors="coerce")
    df = df[wall.notna()].copy()
    wall = wall[wall.notna()]
    if df.empty:
        return df
    return df[wall == wall.max()]


def _best_snapshot(sketch: pd.DataFrame, query: str) -> pd.DataFrame:
    pat = _SKETCH_METRIC_PATTERN.get(query)
    if not pat or sketch.empty:
        return _latest_snapshot(sketch)
    rel = sketch[sketch["metric"].astype(str).str.contains(pat, regex=True, na=False)]
    if rel.empty:
        return _latest_snapshot(sketch)
    numeric = pd.to_numeric(rel["value"], errors="coerce").fillna(0)
    nz = rel[numeric > 0]
    pool = nz if not nz.empty else rel
    best = pool.groupby("scrape_wall_ns").size().idxmax()
    return sketch[sketch["scrape_wall_ns"] == best]


def _qval(labels: dict, keys: tuple[str, ...]) -> float | None:
    for k in keys:
        if k not in labels:
            continue
        try:
            return float(labels[k])
        except (TypeError, ValueError):
            continue
    return None


def _metric_suffix_quantile(metric_name: str) -> float | None:
    suffixes = {
        "_p0": 0.0,
        "_p25": 0.25,
        "_p50": 0.50,
        "_p75": 0.75,
        "_p90": 0.90,
        "_p95": 0.95,
        "_p99": 0.99,
        "_p100": 1.0,
    }
    for suffix, q in suffixes.items():
        if metric_name.endswith(suffix):
            return q
    return None


def _norm_key_part(value: object) -> str:
    try:
        f = float(value)
    except (TypeError, ValueError):
        return str(value)
    if np.isfinite(f) and f.is_integer():
        return str(int(f))
    return str(value)


def _best_aligned_window_error(
    gt: pd.DataFrame,
    estimates: dict,
    gt_key_cols: tuple[str, ...],
    gt_value_col: str,
) -> float:
    if not estimates:
        return float("nan")

    key_names = [f"__key{i}" for i in range(len(gt_key_cols))]
    if len(gt_key_cols) == 1:
        est_rows = [{key_names[0]: k, "__estimate": v} for k, v in estimates.items()]
    else:
        est_rows = [
            {**{key_names[i]: k[i] for i in range(len(key_names))}, "__estimate": v}
            for k, v in estimates.items()
        ]
    est_df = pd.DataFrame(est_rows)
    if est_df.empty:
        return float("nan")

    gt_cols = ["window_start", gt_value_col, *gt_key_cols]
    gt_norm = gt.loc[:, gt_cols].copy()
    for key_name, gt_col in zip(key_names, gt_key_cols):
        gt_norm[key_name] = gt_norm[gt_col].map(_norm_key_part)
    gt_norm[gt_value_col] = pd.to_numeric(gt_norm[gt_value_col], errors="coerce")
    gt_norm = gt_norm[gt_norm[gt_value_col] > 0]
    merged = gt_norm.merge(est_df, on=key_names, how="inner")
    if merged.empty:
        return float("nan")
    merged["__rel_err"] = (
        (pd.to_numeric(merged["__estimate"], errors="coerce") - merged[gt_value_col]).abs()
        / merged[gt_value_col]
    )
    by_window = merged.groupby("window_start")["__rel_err"].mean()
    if by_window.empty:
        return float("nan")
    return float(by_window.min())


def _best_aligned_snapshot_window_error(
    gt: pd.DataFrame,
    estimates: pd.DataFrame,
    gt_key_cols: tuple[str, ...],
    gt_value_col: str,
) -> float:
    if estimates.empty:
        return float("nan")
    ranked = (
        estimates.groupby("scrape_wall_ns")
        .size()
        .sort_index()   # ascending scrape_wall_ns: earlier snapshots first
        .head(50)
        .index
    )
    best = float("nan")
    key_names = [f"__key{i}" for i in range(len(gt_key_cols))]
    for scrape_wall_ns in ranked:
        snap = estimates[estimates["scrape_wall_ns"] == scrape_wall_ns]
        if len(gt_key_cols) == 1:
            est_map = dict(zip(snap[key_names[0]], snap["__estimate"]))
        else:
            est_map = {
                tuple(row[key_name] for key_name in key_names): row["__estimate"]
                for _, row in snap.iterrows()
            }
        err = _best_aligned_window_error(gt, est_map, gt_key_cols, gt_value_col)
        if np.isfinite(err) and (not np.isfinite(best) or err < best):
            best = err
    return best


def _restrict_gt_to_prefix(gt: pd.DataFrame, max_data_minutes: float | None) -> pd.DataFrame:
    if max_data_minutes is None or gt.empty or "window_start" not in gt:
        return gt
    starts = pd.to_numeric(gt["window_start"], errors="coerce")
    starts = starts[starts.notna()]
    if starts.empty:
        return gt
    first = float(starts.min())
    # Q1-Q5 ground truth uses nanoseconds; Q6 joined ground truth uses seconds.
    unit = 1e9 if first > 1e12 else 1.0
    cutoff = first + max_data_minutes * 60.0 * unit
    return gt[pd.to_numeric(gt["window_start"], errors="coerce") <= cutoff].copy()


# ── Q1: CMS heavy-hitter frequency accuracy ──────────────────────────────────

def _compare_q1(gt: pd.DataFrame, sketch: pd.DataFrame, **_kw) -> dict:
    if sketch.empty or gt.empty:
        return {
            "metric": "cms_freq_rel_err",
            "value": float("nan"),
            "threshold": DEFAULT_ACCURACY_THRESHOLD,
            "pass": False,
        }

    # GT: sum total_requests per warehouse across last window
    last_w = gt["window_start"].max()
    gt_w = gt[gt["window_start"] == last_w].copy()
    fleet_total = gt_w["total_requests"].sum()
    gt_map = dict(zip(gt_w["warehouseId"].astype(str), gt_w["total_requests"]))

    # Sketch: read CMS estimates
    estimates: dict[str, float] = {}
    for _, row in sketch.iterrows():
        m = str(row.get("metric", ""))
        if "countsketch_partition" not in m and "countminsketch" not in m:
            continue
        try:
            labels = json.loads(row["labels"])
        except Exception:
            continue
        wh = labels.get("warehouse_id") or labels.get("warehouseId")
        if not wh:
            continue
        try:
            estimates[str(wh)] = float(row["value"])
        except (TypeError, ValueError):
            continue

    if not estimates or fleet_total == 0:
        return {
            "metric": "cms_freq_rel_err",
            "value": float("nan"),
            "threshold": DEFAULT_ACCURACY_THRESHOLD,
            "pass": False,
        }

    errs = []
    for wh, true_f in gt_map.items():
        est = estimates.get(wh, 0.0)
        errs.append(abs(est - true_f) / fleet_total)

    rel_err = float(np.mean(errs))
    return {
        "metric": "cms_freq_rel_err",
        "value": rel_err,
        "threshold": DEFAULT_ACCURACY_THRESHOLD,
        "pass": rel_err <= DEFAULT_ACCURACY_THRESHOLD,
    }


# ── Q2: KLL quantile accuracy ─────────────────────────────────────────────────

def _compare_q2(gt: pd.DataFrame, sketch: pd.DataFrame, **kw) -> dict:
    max_data_minutes = kw.get("max_data_minutes")
    if sketch.empty or (gt.empty and max_data_minutes is None):
        return {
            "metric": "kll_p99_rel_err",
            "value": float("nan"),
            "threshold": DEFAULT_ACCURACY_THRESHOLD,
            "pass": False,
        }

    if max_data_minutes is not None:
        gt_map = _q2_prefix_gt_map(float(max_data_minutes))
    else:
        last_w = gt["window_start"].max()
        gt_w = gt[gt["window_start"] == last_w].copy()
        gt_map = dict(zip(gt_w["warehouseId"].astype(str), gt_w["p99_ms"]))

    sk_p99: dict[str, float] = {}
    for _, row in sketch.iterrows():
        m = str(row.get("metric", ""))
        try:
            labels = json.loads(row["labels"])
        except Exception:
            continue
        scope = str(labels.get("otel_scope_name", ""))
        q = _qval(labels, ("kll.quantile", "kll_quantile"))
        is_p99 = (q is not None and abs(q - 0.99) <= 1e-4) or m.endswith("_p99")
        is_kll = "_kll" in m or scope == "otelcol/kllprocessor" or m.endswith("_p99")
        if not is_kll or not is_p99:
            continue
        wh = labels.get("warehouse_id") or labels.get("warehouseId")
        if not wh:
            continue
        try:
            sk_p99[str(wh)] = float(row["value"])
        except (TypeError, ValueError):
            continue

    if not sk_p99:
        return {
            "metric": "kll_p99_rel_err",
            "value": float("nan"),
            "threshold": DEFAULT_ACCURACY_THRESHOLD,
            "pass": False,
        }

    errs = []
    for wh, true_q in gt_map.items():
        if true_q <= 0:
            continue
        est = sk_p99.get(wh)
        if est is not None:
            errs.append(abs(est - true_q) / true_q)

    if not errs:
        return {
            "metric": "kll_p99_rel_err",
            "value": float("nan"),
            "threshold": DEFAULT_ACCURACY_THRESHOLD,
            "pass": False,
        }

    rel_err = float(np.mean(errs))
    return {
        "metric": "kll_p99_rel_err",
        "value": rel_err,
        "threshold": DEFAULT_ACCURACY_THRESHOLD,
        "pass": rel_err <= DEFAULT_ACCURACY_THRESHOLD,
    }


# ── Q3: DDSketch quantile accuracy ───────────────────────────────────────────

def _compare_q3(gt: pd.DataFrame, sketch: pd.DataFrame, **_kw) -> dict:
    if sketch.empty or gt.empty:
        return {
            "metric": "dds_p99_rel_err",
            "value": float("nan"),
            "threshold": DEFAULT_ACCURACY_THRESHOLD,
            "pass": False,
        }

    rel = sketch[sketch["metric"].astype(str).str.contains("_ddsketch", na=False)].copy()
    if rel.empty:
        estimates = pd.DataFrame()
    else:
        labels = rel["labels"].astype(str)
        rel["__q"] = pd.to_numeric(
            labels.str.extract(r'"ddsketch[._]quantile"\s*:\s*"([^"]+)"', expand=False),
            errors="coerce",
        )
        rel = rel[(rel["__q"] - 0.99).abs() <= 1e-4]
        rel["__key0"] = labels.str.extract(r'"warehouse(?:_id|Id)"\s*:\s*"([^"]+)"', expand=False)
        rel["__estimate"] = pd.to_numeric(rel["value"], errors="coerce")
        estimates = rel.loc[
            rel["__key0"].notna() & rel["__estimate"].notna(),
            ["scrape_wall_ns", "__key0", "__estimate"],
        ].copy()
        estimates["__key0"] = estimates["__key0"].map(_norm_key_part)
    if estimates.empty:
        return {
            "metric": "dds_p99_rel_err",
            "value": float("nan"),
            "threshold": DEFAULT_ACCURACY_THRESHOLD,
            "pass": False,
        }

    rel_err = _best_aligned_snapshot_window_error(gt, estimates, ("warehouseId",), "p99_bytes")
    if not np.isfinite(rel_err):
        return {
            "metric": "dds_p99_rel_err",
            "value": float("nan"),
            "threshold": DEFAULT_ACCURACY_THRESHOLD,
            "pass": False,
        }

    return {
        "metric": "dds_p99_rel_err",
        "value": rel_err,
        "threshold": DEFAULT_ACCURACY_THRESHOLD,
        "pass": rel_err <= DEFAULT_ACCURACY_THRESHOLD,
    }


# ── Q4: CMS archetype share accuracy ─────────────────────────────────────────

def _compare_q4(gt: pd.DataFrame, sketch: pd.DataFrame, **_kw) -> dict:
    if sketch.empty or gt.empty:
        return {
            "metric": "cms_arch_share_err",
            "value": float("nan"),
            "threshold": DEFAULT_ACCURACY_THRESHOLD,
            "pass": False,
        }

    last_w = gt["window_start"].max()
    gt_w = gt[gt["window_start"] == last_w].copy()
    total = gt_w["frequency"].sum()
    gt_shares = {}
    for _, row in gt_w.iterrows():
        key = str(row["query_archetype"])
        gt_shares[key] = row["frequency"] / total if total > 0 else 0.0

    sk_counts: dict[str, float] = {}
    sk_total = 0.0
    for _, row in sketch.iterrows():
        m = str(row.get("metric", ""))
        if "countsketch_partition" not in m and "countminsketch" not in m:
            continue
        try:
            labels = json.loads(row["labels"])
        except Exception:
            continue
        arch = labels.get("query_archetype")
        if not arch:
            continue
        try:
            v = float(row["value"])
        except (TypeError, ValueError):
            continue
        sk_counts[arch] = sk_counts.get(arch, 0.0) + v
        sk_total += v

    if not sk_counts or sk_total == 0:
        return {
            "metric": "cms_arch_share_err",
            "value": float("nan"),
            "threshold": DEFAULT_ACCURACY_THRESHOLD,
            "pass": False,
        }

    errs = []
    for arch, true_s in gt_shares.items():
        est_s = sk_counts.get(arch, 0.0) / sk_total
        errs.append(abs(est_s - true_s))

    err = float(np.mean(errs))
    return {
        "metric": "cms_arch_share_err",
        "value": err,
        "threshold": DEFAULT_ACCURACY_THRESHOLD,
        "pass": err <= DEFAULT_ACCURACY_THRESHOLD,
    }


# ── Q5: HLL distinct warehouse count accuracy ─────────────────────────────────

def _compare_q5(gt: pd.DataFrame, sketch: pd.DataFrame, **_kw) -> dict:
    if sketch.empty or gt.empty:
        return {
            "metric": "hll_cardinality_rel_err",
            "value": float("nan"),
            "threshold": DEFAULT_ACCURACY_THRESHOLD,
            "pass": False,
        }

    last_w = gt["window_start"].max()
    exact = gt.loc[gt["window_start"] == last_w, "exact_distinct_warehouses"].iloc[0]
    if exact <= 0:
        return {
            "metric": "hll_cardinality_rel_err",
            "value": float("nan"),
            "threshold": DEFAULT_ACCURACY_THRESHOLD,
            "pass": False,
        }

    # HLL emits one cardinality row per active series
    hll_count = 0
    for _, row in sketch.iterrows():
        if "_hll_cardinality" not in str(row.get("metric", "")):
            continue
        try:
            v = float(row["value"])
        except (TypeError, ValueError):
            continue
        if v > 0:
            hll_count += 1

    # Fallback: read hll.cardinality attribute if available
    if hll_count == 0:
        for _, row in sketch.iterrows():
            try:
                labels = json.loads(row["labels"])
            except Exception:
                continue
            c = labels.get("hll.cardinality")
            if c is not None:
                try:
                    hll_count = int(float(c))
                    break
                except (TypeError, ValueError):
                    pass

    rel_err = abs(hll_count - exact) / exact
    return {
        "metric": "hll_cardinality_rel_err",
        "value": rel_err,
        "threshold": DEFAULT_ACCURACY_THRESHOLD,
        "pass": rel_err <= DEFAULT_ACCURACY_THRESHOLD,
    }


# ── Q6: KLL p95/p99 latency by concurrency band accuracy ─────────────────────

def _compare_q6(gt: pd.DataFrame, sketch: pd.DataFrame, **_kw) -> dict:
    if sketch.empty or gt.empty:
        return {
            "metric": "kll_p95_concurrency_band_rel_err",
            "value": float("nan"),
            "threshold": DEFAULT_ACCURACY_THRESHOLD,
            "pass": False,
        }

    fallback_ws = None
    gt_ws = gt["warehouseSize"].dropna().map(_norm_key_part).unique()
    if len(gt_ws) == 1:
        fallback_ws = gt_ws[0]
    metrics = sketch["metric"].astype(str)
    labels_all = sketch["labels"].astype(str)
    # Detect KLL metrics by metric name suffix OR by otelcol/kllprocessor scope label.
    kll_scope = labels_all.str.contains('"otelcol/kllprocessor"', na=False)
    rel = sketch[
        metrics.str.endswith("_p95") | metrics.str.endswith("_p99") |
        metrics.str.contains("_kll", na=False) | kll_scope
    ].copy()
    if rel.empty:
        estimates = pd.DataFrame()
        gt_val_col = "p95_ms"
        metric_key = "kll_p95_concurrency_band_rel_err"
    else:
        labels = rel["labels"].astype(str)
        rel["__q"] = pd.to_numeric(
            labels.str.extract(r'"kll[._]quantile"\s*:\s*"([^"]+)"', expand=False),
            errors="coerce",
        )
        suffix_q = rel["metric"].astype(str).map(_metric_suffix_quantile)
        rel["__q"] = rel["__q"].fillna(suffix_q)
        # Prefer p95; fall back to p99 when the sketch does not emit a p95 quantile.
        if ((rel["__q"] - 0.95).abs() <= 1e-4).any():
            rel = rel[(rel["__q"] - 0.95).abs() <= 1e-4]
            gt_val_col = "p95_ms"
            metric_key = "kll_p95_concurrency_band_rel_err"
        else:
            rel = rel[(rel["__q"] - 0.99).abs() <= 1e-4]
            gt_val_col = "p99_ms"
            metric_key = "kll_p99_concurrency_band_rel_err"
        rel["__key0"] = labels.str.extract(r'"warehouse(?:_size|Size)"\s*:\s*"([^"]+)"', expand=False)
        if fallback_ws is not None:
            rel["__key0"] = rel["__key0"].fillna(fallback_ws)
        rel["__key1"] = labels.str.extract(r'"concurrency_band"\s*:\s*"([^"]+)"', expand=False)
        rel["__estimate"] = pd.to_numeric(rel["value"], errors="coerce")
        estimates = rel.loc[
            rel["__key0"].notna() & rel["__key1"].notna() & rel["__estimate"].notna(),
            ["scrape_wall_ns", "__key0", "__key1", "__estimate"],
        ].copy()
        estimates["__key0"] = estimates["__key0"].map(_norm_key_part)
        estimates["__key1"] = estimates["__key1"].map(_norm_key_part)
    if estimates.empty:
        return {
            "metric": metric_key,
            "value": float("nan"),
            "threshold": DEFAULT_ACCURACY_THRESHOLD,
            "pass": False,
        }

    rel_err = _best_aligned_snapshot_window_error(
        gt, estimates, ("warehouseSize", "concurrency_band"), gt_val_col,
    )
    if not np.isfinite(rel_err):
        return {
            "metric": metric_key,
            "value": float("nan"),
            "threshold": DEFAULT_ACCURACY_THRESHOLD,
            "pass": False,
        }

    return {
        "metric": metric_key,
        "value": rel_err,
        "threshold": DEFAULT_ACCURACY_THRESHOLD,
        "pass": rel_err <= DEFAULT_ACCURACY_THRESHOLD,
    }


_COMPARE_DISPATCH: dict[str, Callable] = {
    "Q1": _compare_q1,
    "Q2": _compare_q2,
    "Q3": _compare_q3,
    "Q4": _compare_q4,
    "Q5": _compare_q5,
    "Q6": _compare_q6,
}


def run_comparison(
    query: str,
    slice_tag: str,
    gt_dir: Path,
    sketch_dir: Path,
    out_dir: Path,
    max_data_minutes: float | None = None,
) -> None:
    gt_path = gt_dir / query / f"{slice_tag}.csv"
    sketch_path = sketch_dir / query / f"{slice_tag}.csv"
    can_compute_gt = query == "Q2" and max_data_minutes is not None
    if not gt_path.is_file() and not can_compute_gt:
        print(f"GT file missing: {gt_path}", file=sys.stderr)
        return
    gt = pd.read_csv(gt_path) if gt_path.is_file() else pd.DataFrame()
    gt = _restrict_gt_to_prefix(gt, max_data_minutes)
    sketch = (pd.read_csv(sketch_path, on_bad_lines="skip", low_memory=False)
              if sketch_path.is_file() else pd.DataFrame())
    out_dir.mkdir(parents=True, exist_ok=True)
    fn = _COMPARE_DISPATCH.get(query)
    if fn is None:
        return
    # Q3/Q6 sketches are cumulative: early snapshots match per-window GT; pass full
    # sketch so the compare function can search all snapshots via
    # _best_aligned_snapshot_window_error (ascending scrape_wall_ns order).
    if query in ("Q3", "Q6"):
        result = fn(gt, sketch, max_data_minutes=max_data_minutes)
    else:
        snapshot = _best_snapshot(sketch, query)
        result = fn(gt, snapshot, max_data_minutes=max_data_minutes)
    pd.DataFrame([{"query": query, "slice": slice_tag, **result}]).to_csv(
        out_dir / f"{query}_{slice_tag}.csv", index=False
    )


def main() -> None:
    parser = argparse.ArgumentParser(description="Compare sketch scrapes to ground truth.")
    parser.add_argument("--query", default="Q1")
    parser.add_argument("--slice", default="full")
    parser.add_argument("--gt-dir", type=Path,
                        default=Path(__file__).resolve().parent / "results" / "ground_truth")
    parser.add_argument("--sketch-dir", type=Path,

# Multi-node Gorilla+Thanos topology — 4 nodes on 10.10.1.0/24, 10Gbps.
# Simplified variant of mvp-multinode: gorillas3-only pipeline (no sketch
# processors, no routing connector, no OpAMP/controller), Thanos query engine
# + MinIO storage. No gorilla-gateway — agents POST per-emit blocks to the
# head merger; the merger cuts and flushes completed windows to MinIO.
# Sourced by scripts/run_demo.sh.

# ── Node IPs ──
NODE0_IP=10.10.1.1   # producers + agent-a (data source)
NODE1_IP=10.10.1.2   # idle (no services in this topology)
NODE2_IP=10.10.1.3   # backend: ASAPQuery-backend + MinIO + Thanos + gorilla-head-merger + gorilla-buffer-store=hot-store
NODE3_IP=10.10.1.4   # producers + agent-b (data source)

NODE0_HOST=node0
NODE1_HOST=node1
NODE2_HOST=node2
NODE3_HOST=node3

# ── DNS aliases injected via --add-host on every container.
# All active services are on node0, node2, node3 — no node1 services.
# IMPORTANT: NODE*_IP variables MUST be defined above BEFORE this array is
# evaluated by the shell.
ADD_HOSTS=(
    --add-host=minio:${NODE2_IP}
    --add-host=thanos-query:${NODE2_IP}
    --add-host=thanos-store-gateway:${NODE2_IP}
    --add-host=thanos-compact:${NODE2_IP}
    --add-host=backend:${NODE2_IP}
    --add-host=asap-backend:${NODE2_IP}
    --add-host=gorilla-buffer-store:${NODE2_IP}
    --add-host=gorilla-head-merger:${NODE2_IP}
    --add-host=agent-a:${NODE0_IP}
    --add-host=agent-b:${NODE3_IP}
)

# ── Merger ingest endpoint. Agents POST per-emit Gorilla blocks here (instead of
# PUTting them to S3); resolved via the gorilla-head-merger add-host above →
# NODE2_IP. agent-gorilla-only.yaml sets gorillas3 ship_endpoint to this URL.
MERGER_INGEST_PORT="${MERGER_INGEST_PORT:-9099}"

# ── Workload sizing (same defaults as mvp-multinode).
PER_AGENT_CARDINALITY="${PER_AGENT_CARDINALITY:-4}"
EXPORTER_FREQ_HZ="${EXPORTER_FREQ_HZ:-1}"
EXPORTER_RATE="${EXPORTER_RATE:-1000}"
EXPORTER_SDK_WINDOW="${EXPORTER_SDK_WINDOW:-1s}"
EXPORTER_SDK_AGG="${EXPORTER_SDK_AGG:-default}"
EXPORTER_MAX_BUFFER_PER_SERIES="${EXPORTER_MAX_BUFFER_PER_SERIES:-10}"
EXPORTER_FRESHNESS_PROBES="${EXPORTER_FRESHNESS_PROBES:-on}"
EXPORTER_FRESHNESS_PROBE_HZ="${EXPORTER_FRESHNESS_PROBE_HZ:-1.0}"
EXPORTER_FIVE_SKETCH="${EXPORTER_FIVE_SKETCH:-off}"
EXPORTER_FIXED_LATENCY="${EXPORTER_FIXED_LATENCY:-42.0}"
N_PRODUCERS_PER_NODE="${N_PRODUCERS_PER_NODE:-1}"

# ── Hot-store retention horizon (configurable).
# gorilla-head-merger keeps cut tumbling windows newer than BUFFER_STORE_DURATION
# in the served dir; the hot-store (gorilla-buffer-store) serves those + the
# current window's per-emit blocks, and the archive-store (thanos-store-gateway)
# serves everything (including older data) from MinIO.
# Format: Go duration string — e.g. 1h, 30m, 2h. Passed to the merger as -retention.
BUFFER_STORE_DURATION="${BUFFER_STORE_DURATION:-1h}"

# ── Tumbling window size for the merger (fixed, non-overlapping windows).
# A block belongs to window floor(block.minTime / MERGE_WINDOW). Passed as -window.
# It is the granularity at which the head is cut and flushed to S3/MinIO.
# Defaults to 1h; usually left equal to (or a divisor of) BUFFER_STORE_DURATION.
MERGE_WINDOW="${MERGE_WINDOW:-1h}"

# ── Soak / replay timing.
WARMUP_S="${WARMUP_S:-30}"
SOAK_S="${SOAK_S:-90}"

# ── Image set (must be pre-loaded on every node that uses them).
# NOTE: asap/asap-otel:dev must be rebuilt with gorillas3 Phase 3 patches
#       (PR #388, 2026-05-17) before using this config — the `bucket:` field
#       was removed; older images reject a config without it.
#       Rebuild: cd /mydata/ASAPCollector && bash restore_otel_collector_contrib_patches.sh && bash build_asap_otel.sh
IMAGES=(
    asap/asap-otel:dev
    asap/fake-exporter:dev
    asap/query-backend:dev
)
EXTERNAL_IMAGES=(
    minio/minio:latest
    minio/mc:latest
    quay.io/thanos/thanos:v0.41.0
)

# ── Paths (assume /mydata on every node).
# ROOT is overridable so the demo can be driven from a git worktree checkout
# (e.g. ROOT=/mydata/ASAPCollector/.claude/worktrees/<wt> bash run_demo.sh ...),
# which syncs that checkout's configs to the nodes instead of the main tree's.
ROOT="${ROOT:-/mydata/ASAPCollector}"
DEPLOY=/mydata/gorilla-thanos-multinode
CONFIG_SRC=${ROOT}/deploy/gorilla-thanos-multinode/configs
RUN_BASE=${DEPLOY}/results
LOG_BASE=${DEPLOY}/logs

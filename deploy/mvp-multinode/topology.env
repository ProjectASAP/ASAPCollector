# Multi-node MVP topology — 4 nodes on 10.10.1.0/24, 10Gbps.
# Sourced by run_demo.sh and helper scripts.

# ── Node IPs ──
NODE0_IP=10.10.1.1   # producers + agent-a (data source)
NODE1_IP=10.10.1.2   # gateway (ASAP arm only)
NODE2_IP=10.10.1.3   # backend stack (asap-query-backend, MinIO, Thanos, Prometheus, controller)
NODE3_IP=10.10.1.4   # producers + agent-b (data source)

NODE0_HOST=node0
NODE1_HOST=node1
NODE2_HOST=node2
NODE3_HOST=node3

# ── DNS aliases that get injected via --add-host on every container.
# Preserves the existing service-name references in the agent/gateway/backend
# YAML configs (e.g., gateway:4317, backend:9091, controller:4320, minio:9000,
# thanos-query:10903) without rewriting any of them.
ADD_HOSTS=(
    --add-host=controller:${NODE2_IP}
    --add-host=backend:${NODE2_IP}
    --add-host=minio:${NODE2_IP}
    --add-host=prometheus:${NODE2_IP}
    --add-host=prometheus-b0:${NODE2_IP}
    --add-host=victoriametrics:${NODE2_IP}
    --add-host=thanos-query:${NODE2_IP}
    --add-host=thanos-store-gateway:${NODE2_IP}
    --add-host=thanos-compact:${NODE2_IP}
    --add-host=gateway:${NODE1_IP}
    --add-host=agent-a:${NODE0_IP}
    --add-host=agent-b:${NODE3_IP}
)

# ── Workload sizing for ≥1 GB/s baseline raw bandwidth.
# 200K series total @ 100 Hz × ~50 B/OTLP sample ≈ 1 GB/s aggregate.
# Split: 5 producers/node × 20K series × 100 Hz on node0 + node3.
PER_AGENT_CARDINALITY="${PER_AGENT_CARDINALITY:-1000}"
EXPORTER_FREQ_HZ="${EXPORTER_FREQ_HZ:-100}"
EXPORTER_RATE="${EXPORTER_RATE:-1000}"
# Stock-OTel-equivalent: SDK Sum/LastValue aggregation with a window so small
# (10ms) that each FREQ_HZ=100 event lands in its own window — semantically
# emits 1 sample per generated event, but via the standard OTel SDK path
# (NOT the patched raw-buffer extension). Wire rate = FREQ_HZ × cardinality
# × per-sample-bytes, identical to raw-buffer at the same generation rate.
EXPORTER_SDK_WINDOW="${EXPORTER_SDK_WINDOW:-1s}"
EXPORTER_SDK_AGG="${EXPORTER_SDK_AGG:-default}"
EXPORTER_MAX_BUFFER_PER_SERIES="${EXPORTER_MAX_BUFFER_PER_SERIES:-10}"
EXPORTER_FRESHNESS_PROBES="${EXPORTER_FRESHNESS_PROBES:-on}"
EXPORTER_FRESHNESS_PROBE_HZ="${EXPORTER_FRESHNESS_PROBE_HZ:-1.0}"
# Disable the built-in five-sketch workload (5 sketch types × 5K series = 25K
# sketch instances per producer) — too heavy for raw-buffer + 100Hz; without
# it the producers cleanly emit just the configured http_requests_total metric.
EXPORTER_FIVE_SKETCH="${EXPORTER_FIVE_SKETCH:-off}"
# 5 producers/node × 1K cardinality at 100Hz raw-buffer → ~250 MB/s aggregate
# raw event rate, ~50 MB/s aggregate wire. Higher producer counts crash the
# docker daemon on the producer nodes (each raw-buffer producer is
# CPU+RAM hungry at this freq).
N_PRODUCERS_PER_NODE="${N_PRODUCERS_PER_NODE:-5}"

# ── Soak / replay timing.
WARMUP_S="${WARMUP_S:-30}"
SOAK_S="${SOAK_S:-90}"

# ── Image set (must be loaded on every node).
#
# Phase-9 single-binary refactor (#373): the controller binary now
# ships from `asap/query-backend:dev` (via Dockerfile.backend's
# multi-bin build); the standalone `asap/controller:dev` image is
# gone. The 4-node orchestrator's run_demo.sh runs the controller
# in-process inside the asap-backend container — no separate
# controller container.
IMAGES=(
    asap/asap-otel:dev
    asap/fake-exporter:dev
    asap/query-backend:dev
)
EXTERNAL_IMAGES=(
    minio/minio:latest
    minio/mc:latest
    prom/prometheus:v2.55.0
    quay.io/thanos/thanos:v0.41.0
)

# ── Paths (assume /mydata on every node).
ROOT=/mydata/ASAPCollector
BACKEND=/mydata/ASAPQuery-backend
SKETCHLIB=/mydata/asap_sketchlib
DEPLOY=/mydata/mvp-multinode
CONFIG_SRC=${ROOT}/deploy/mvp-multinode/configs
RUN_BASE=${DEPLOY}/results
LOG_BASE=${DEPLOY}/logs

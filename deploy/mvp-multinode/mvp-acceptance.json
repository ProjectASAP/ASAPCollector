{
  "schema_version": 1,
  "baseline_arm": "b1",
  "asap_arm": "asap-gzip",
  "minimum_successful_queries_per_kind": 5,
  "accuracy": {
    "relative_error_by_kind": {
      "quantile": 0.05,
      "sum": 0.000001,
      "frequency": 0.05,
      "count_unique": 0.05,
      "topk": 0.10
    },
    "minimum_within_sla_fraction": 0.95
  },

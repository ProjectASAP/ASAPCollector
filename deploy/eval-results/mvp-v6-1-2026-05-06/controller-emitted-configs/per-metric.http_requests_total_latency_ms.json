extensions:
  opamp:
    server:
      ws:
        endpoint: ws://controller:4320/v1/opamp
receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318
    enable_series_id: true
processors:
  ddsketch:
    mode: window
    enable_self_monitoring: true
    transmit_sketch: false
    window_duration: 5m
    relative_accuracy: 0.010000000000000009
    quantiles:
    - 0.99
exporters:
  otlp/backend:
    endpoint: backend:4317
    tls:
      insecure: true
    compression: none
service:
  extensions:
  - opamp
  pipelines:
    metrics:
      receivers:
      - otlp
      processors:
      - ddsketch
      exporters:
      - otlp/backend

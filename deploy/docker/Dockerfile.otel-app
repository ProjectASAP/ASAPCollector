# Small Go build for the otel-app OTLP metrics producer. See
# `otel-app/main.go` for the behavior spec.
#
# The build pulls in the ASAP-patched OTel SDK (for the sketch
# aggregators — AggregationDDSketch/KLLSketch/CountSketch/CountMinSketch/
# HLLSketch + AggregationRawBuffer + DeltaTransmission flags, see
# docs/sdk-cost-evaluation.md) and the sketchlib-go sibling repo.
#
# ## Prereq: combine the patches onto the upstream trees
#
#   ./restore_opentelemetry_go_patches.sh
#   ./restore_otel_proto_patches.sh
#
# Those walk the `opentelemetry-go-patch/` and `opentelemetry-proto-patch/`
# directories and copy their contents on top of `opentelemetry-go/` and
# `opentelemetry-proto/` respectively. The combined trees are what the
# `go.mod` replaces point at. The proto-patch carries the patched `.proto`
# sources AND the regenerated `gen/go/...` Go bindings (mpb.DDSketch,
# mpb.KLLSketch, mpb.CountSketch, mpb.CountMinSketch, mpb.HLLSketch types
# + the `MetricsService` gRPC client). See
# `opentelemetry-proto-patch/REGEN.md` for the regeneration recipe.
#
# ## Build
#
# Uses BuildKit named build contexts so sketchlib-go (which lives
# outside this repo) can be supplied without vendoring:
#
#   DOCKER_BUILDKIT=1 docker build \
#     -f deploy/docker/Dockerfile.otel-app \
#     --build-context sketchlib-go=/path/to/sketchlib-go \
#     -t asap/otel-app:dev .
#
# The default repo layout on a dev box is /mydata/{DataCollector,
# sketchlib-go}, so from /mydata/DataCollector the path is
# `../sketchlib-go`.

FROM golang:1.25-bookworm AS build
WORKDIR /src

# Main repo tree (contains opentelemetry-go and opentelemetry-proto with
# patches applied and the otel-app source). The replace directives in
# opentelemetry-go's exporter go.mod files point at
# ../../../../../opentelemetry-proto/gen/go/go.opentelemetry.io/proto/otlp,
# so opentelemetry-proto/ must be present alongside opentelemetry-go/ in the
# build context root.
COPY opentelemetry-go     /src/opentelemetry-go
COPY opentelemetry-proto  /src/opentelemetry-proto
COPY otel-app             /src/otel-app

# otel-app/sample_controller.go imports asap-precompute-go/monitor{,/grpcclient}
# (the coordinated-sampling client), and otel-app/go.mod replaces them at
# ../asap-precompute-go{,/monitor/grpcclient}. That sibling tree lives outside
# this Dockerfile's default context, so supply it as a named build context and
# COPY it to /src/asap-precompute-go (the `../` replace then resolves verbatim).
#   docker build --build-context asap-precompute-go=/path/to/asap-precompute-go ...
COPY --from=asap-precompute-go . /src/asap-precompute-go

# Sketchlib-go pulled via named build context to avoid a submodule
# hop outside this repo.
COPY --from=sketchlib-go . /src/sketchlib-go

# asap-precompute-go (monitor.Engine + grpcclient, used by the coordinated
# sampling edge) pulled via named build context. go.mod replaces it with
# ../asap-precompute-go; from /src/otel-app that resolves to /src/asap-precompute-go,
# so copy it there — no replace rewrite needed.
COPY --from=asap-precompute-go . /src/asap-precompute-go

# The go.mod replace references ../../sketchlib-go (the local checkout sits at
# the workspace root, one level above the repo root). Inside /src it was
# COPY'd to /src/sketchlib-go, so rewrite the replace to that absolute path.
RUN sed -i \
    's|github.com/ProjectASAP/sketchlib-go => ../../sketchlib-go|github.com/ProjectASAP/sketchlib-go => /src/sketchlib-go|' \
    /src/otel-app/go.mod

WORKDIR /src/otel-app
RUN go mod tidy && \
    CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/otel-app .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/otel-app /usr/local/bin/otel-app
ENTRYPOINT ["/usr/local/bin/otel-app"]

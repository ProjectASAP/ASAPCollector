# gorilla-gateway — buffering S3 proxy between OTel agents and MinIO.
# Simple standalone binary: only depends on minio-go, no ASAP patches needed.
#
# Build (from ASAPCollector repo root):
#   docker build -f deploy/docker/Dockerfile.gorilla-gateway #     -t asap/gorilla-gateway:dev .

FROM golang:1.25-bookworm AS build
WORKDIR /src
COPY deploy/gorilla-gateway /src/gorilla-gateway
WORKDIR /src/gorilla-gateway
RUN go mod tidy &&     CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/gorilla-gateway .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/gorilla-gateway /usr/local/bin/gorilla-gateway
ENTRYPOINT ["/usr/local/bin/gorilla-gateway"]

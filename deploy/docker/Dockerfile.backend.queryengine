# Multi-stage build for the alternative ASAPQuery backend
# binary (`query_engine_rust`, the workspace's default binary).
# Same source tree as Dockerfile.backend; this variant simply
# builds and ships `query_engine_rust` instead of
# `precompute_engine`.
#
# Why two images:
#  - `precompute_engine` (Dockerfile.backend) is the focused
#    binary today's e2e / sweep harness drives. Smaller flag
#    surface, fewer optional subsystems.
#  - `query_engine_rust` (this file) is the more featureful
#    binary: controller-client / planner-client, schema-eviction,
#    backfill-worker, query-tracker, full PRW + OTLP ingest.
#    Use the matching `queryengine-overlay.yml` to wire its
#    extra required flags into the compose stack.
#
# Both expose `--enable-otel-ingest` (gRPC 4317 / HTTP 4318) and
# accept the same `streaming.yaml` schema, so the warm-tier
# sketch path is identical at the wire level.
#
#   # Local checkout:
#   DOCKER_BUILDKIT=1 docker build \
#     -f deploy/docker/Dockerfile.backend.queryengine \
#     --build-context backend-src=/path/to/ASAPQuery-backend \
#     -t asap/query-backend-queryengine:dev .
#
# The `:dev` tag is what `queryengine-overlay.yml` references.
FROM rust:1.90-bookworm AS build
WORKDIR /src

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        protobuf-compiler git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=backend-src . backend
# `query_engine_rust` is the package name and the default
# (src/main.rs) binary, so --bin is redundant but explicit.
RUN cd backend && cargo build --release --bin query_engine_rust

FROM debian:bookworm-slim
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*
COPY --from=build /src/backend/target/release/query_engine_rust \
    /usr/local/bin/asap-query-backend

ENV RUST_LOG=info \
    ASAP_BACKEND_PORT=9090 \
    ASAP_BACKEND_METRICS_PORT=9465

EXPOSE 8088 9090 9465 4317 4318
ENTRYPOINT ["/usr/local/bin/asap-query-backend"]

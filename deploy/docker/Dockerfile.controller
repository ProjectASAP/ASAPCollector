# Multi-stage build for the controller binary. Builds cleanly
# from the top-level repo; run:
#
#   docker build -f deploy/docker/Dockerfile.controller -t asap/controller:dev .
#
# The `:dev` tag is what `deploy/docker-compose/base.yml`
# references via its `build:` block — you don't normally invoke
# this file directly.
FROM rust:1.80-bookworm AS build
WORKDIR /src

# Cache deps: copy manifests first, fetch, then the full tree.
COPY controller/Cargo.toml controller/Cargo.lock ./controller/
RUN mkdir -p controller/src && \
    echo "fn main() {}" > controller/src/main.rs && \
    cd controller && cargo fetch

COPY controller controller
RUN cd controller && cargo build --release --bin controller

# Runtime image kept small — just the binary + ca-certs for
# outbound HTTPS (controller talks to the backend + any S3
# endpoint the planner's future raw-data analyzer hits).
FROM debian:bookworm-slim
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*
COPY --from=build /src/controller/target/release/controller /usr/local/bin/controller

ENV CONTROLLER_ADDR=0.0.0.0:8080 \
    CONTROLLER_OPAMP_ADDR=0.0.0.0:4320 \
    RUST_LOG=info

EXPOSE 8080 4320
ENTRYPOINT ["/usr/local/bin/controller"]

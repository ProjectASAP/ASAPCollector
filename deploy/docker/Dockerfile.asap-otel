# Full asap-otel image — the ASAP-patched OpenTelemetry Collector
# with DDSketch / KLL / HLL / CountSketch / CountMinSketch
# processors compiled in. This is the image the paper's B2
# (hand-tuned sketches) and B3 (full ASAP) baselines need.
#
# ## Build model: host-build, container-ship
#
# The patched collector depends on the private
# `ProjectASAP/sketchlib-go` module. Running the full OCB build
# inside Docker fights with go's private-module resolution (go
# mod tidy hits sum.golang.org for sketchlib-go even with a
# replace directive in the build config). Rather than thread
# SSH keys + GOPRIVATE + replace-injection through BuildKit,
# this Dockerfile is just a runtime stage that wraps the
# pre-built binary.
#
# ## Prereqs (run once on the build host)
#
# 1. Initialize the upstream submodules so the patches can be
#    applied on top:
#
#      git submodule update --init --recursive \
#        opentelemetry-collector \
#        opentelemetry-collector-contrib \
#        opentelemetry-proto
#
# 2. Check out `ProjectASAP/sketchlib-go` at the sibling path
#    `../sketchlib-go` (relative to the ASAPCollector repo). The
#    OCB manifest's `replaces:` section points there as
#    `../../../../sketchlib-go` from `cmd/asap-otel/go.mod`.
#    Use `main` for a known-good API surface (NewFromState,
#    SerializeMsgpack on all five sketches, DeserializeDelta).
#
# 3. Build the collector:
#
#      GOPRIVATE='github.com/ProjectASAP/*' \
#        bash build_asap_otel.sh --skip-patches
#
#    Binary lands at
#    `opentelemetry-collector-contrib-patch/cmd/asap-otel/asap-otel`.
#
# 5. Build this image (the COPY below expects the binary to be
#    present in the build context):
#
#      docker build -f deploy/docker/Dockerfile.asap-otel \
#        -t asap/asap-otel:dev .
#
# For a stock-otel fallback that skips all of this, use
# `Dockerfile.asap-otel-stock` — covers B0 + B1 baselines only.

FROM debian:bookworm-slim
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY opentelemetry-collector-contrib-patch/cmd/asap-otel/asap-otel \
    /usr/local/bin/asap-otel

EXPOSE 4317 4318 8888 9464
ENTRYPOINT ["/usr/local/bin/asap-otel"]
CMD ["--config=/etc/otel/config.yaml"]

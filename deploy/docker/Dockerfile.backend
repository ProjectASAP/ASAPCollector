# Multi-stage build for the ASAPQuery backend.
#
# The backend source lives in a separate private repo
# (ProjectASAP/ASAPQuery-backend). We take it as a BuildKit
# named build-context. Two additional path-deps live as siblings
# in the canonical dev layout (`~/repos/{ASAPCollector, asap_sketchlib,
# ASAPQuery-backend}`) and must be supplied as build contexts too —
# the backend's `asap-query-engine/Cargo.toml` path-deps
# `asap-precompute-rs = { path = "../../ASAPCollector/asap-precompute-rs" }`
# and that crate's own `Cargo.toml` path-deps
# `asap_sketchlib = { path = "../../asap_sketchlib" }`. Inside the
# build container we recreate the same relative layout under /src.
#
#   # Option A: local checkouts
#   DOCKER_BUILDKIT=1 docker build -f deploy/docker/Dockerfile.backend \
#     --build-context backend-src=/path/to/ASAPQuery-backend \
#     --build-context asap-precompute-rs=/path/to/ASAPCollector/asap-precompute-rs \
#     --build-context asap-sketchlib=/path/to/asap_sketchlib \
#     -t asap/query-backend:dev .
#
# The `:dev` tag is what `deploy/docker-compose/base.yml`
# references.
FROM rust:1.90-bookworm AS build
WORKDIR /src

# protoc for the backend's prost-build usages.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        protobuf-compiler git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Recreate the canonical sibling-checkout layout the backend's
# path-deps expect:
#
#   /src/ASAPQuery-backend/...
#   /src/ASAPCollector/asap-precompute-rs/...
#   /src/asap_sketchlib/...
#
# Then build from inside the backend dir so cargo resolves
# `../../ASAPCollector/asap-precompute-rs` and `../../asap_sketchlib`
# to the in-container paths.
COPY --from=backend-src        . ASAPQuery-backend
COPY --from=asap-precompute-rs . ASAPCollector/asap-precompute-rs
COPY --from=asap-sketchlib     . asap_sketchlib
# Phase-3 cold-engine: backend's `asap-query-engine/Cargo.toml`
# path-deps `asap-gorilla = { path = "../../ASAPCollector/asap-gorilla" }`.
# Mirrors the asap-precompute-rs pattern.
COPY --from=asap-gorilla       . ASAPCollector/asap-gorilla

RUN cd ASAPQuery-backend && cargo build --release --bin precompute_engine

# Runtime image: binary + CA certs.
FROM debian:bookworm-slim
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*
COPY --from=build /src/ASAPQuery-backend/target/release/precompute_engine \
    /usr/local/bin/asap-query-backend

ENV RUST_LOG=info \
    ASAP_BACKEND_PORT=9090 \
    ASAP_BACKEND_METRICS_PORT=9465

EXPOSE 9090 9465
ENTRYPOINT ["/usr/local/bin/asap-query-backend"]

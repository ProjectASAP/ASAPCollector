# Multi-stage build for the ASAPQuery backend.
#
# Builds and ships the workspace's default binary
# (`query_engine_rust`, from `asap-query-engine/src/main.rs`) as
# the runtime entry. This is the single, featureful backend
# binary: warm-tier sketches, controller capability-miss
# notifications, schema eviction, backfill worker, archive-tier
# Gorilla / Thanos forwarding, Prometheus forwarding, and the
# full storage routing surface.
#
# Background: this Dockerfile previously shipped the
# `precompute_engine` `[[bin]]` from
# `asap-query-engine/src/bin/precompute_engine.rs`, which had a
# divergent clap flag set and parallel runtime wiring. Every new
# `src/main.rs` feature had to be backported by hand (PR #105 hot
# reload, PR #332's `--ingest-port` removal, etc.). The cleanup
# PR aligning the deployed binary made the relevant flags on
# `src/main.rs` optional with sensible defaults, added
# `--query-port` / `--inference-config` / `--allowed-lateness-ms`
# aliases, kept `--ingest-port` as a deprecated no-op for compose
# backwards compatibility, and deleted `precompute_engine.rs`
# entirely. The compose `command:` blocks in this repo continue
# to work unchanged.
#
# The backend source lives in a separate private repo
# (ProjectASAP/ASAPQuery-backend). We take it as a BuildKit
# named build-context. Two additional path-deps live as siblings
# in the canonical dev layout (`~/repos/{ASAPCollector, asap_sketchlib,
# ASAPQuery-backend}`) and must be supplied as build contexts too —
# the backend's `asap-query-engine/Cargo.toml` path-deps
# `asap-precompute-rs = { path = "../../ASAPCollector/asap-precompute-rs" }`
# and that crate's own `Cargo.toml` path-deps
# `asap_sketchlib = { path = "../../asap_sketchlib" }`. Inside the
# build container we recreate the same relative layout under /src.
#
#   # Option A: local checkouts
#   DOCKER_BUILDKIT=1 docker build -f deploy/docker/Dockerfile.backend \
#     --build-context backend-src=/path/to/ASAPQuery-backend \
#     --build-context asap-precompute-rs=/path/to/ASAPCollector/asap-precompute-rs \
#     --build-context asap-sketchlib=/path/to/asap_sketchlib \
#     -t asap/query-backend:dev .
#
# The `:dev` tag is what `deploy/docker-compose/base.yml`
# references.
FROM rust:1.90-bookworm AS build
WORKDIR /src

# protoc for the backend's prost-build usages.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        protobuf-compiler git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Recreate the canonical sibling-checkout layout the backend's
# path-deps expect:
#
#   /src/ASAPQuery-backend/...
#   /src/ASAPCollector/asap-precompute-rs/...
#   /src/asap_sketchlib/...
#
# Then build from inside the backend dir so cargo resolves
# `../../ASAPCollector/asap-precompute-rs` and `../../asap_sketchlib`
# to the in-container paths.
COPY --from=backend-src        . ASAPQuery-backend
COPY --from=asap-precompute-rs . ASAPCollector/asap-precompute-rs
COPY --from=asap-sketchlib     . asap_sketchlib
# Phase-3 cold-engine: backend's `asap-query-engine/Cargo.toml`
# path-deps `asap-gorilla = { path = "../../ASAPCollector/asap-gorilla-rust" }`.
# Mirrors the asap-precompute-rs pattern.
COPY --from=asap-gorilla-rust  . ASAPCollector/asap-gorilla-rust

# Data-plane reorg (2026-05): the workspace's binary targets were
# renamed `query_engine_rust` → `data_plane` and `controller` →
# `control_plane`. The runtime install paths below
# (`/usr/local/bin/asap-query-backend`, `/usr/local/bin/controller`)
# are preserved so the existing compose stacks keep working
# without edits.
RUN cd ASAPQuery-backend && cargo build --release --bin data_plane --bin control_plane

# Runtime image: binaries + CA certs.
FROM debian:bookworm-slim
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*
# Logs default to /var/log/asap (binary's --output-dir default);
# create it so the binary can write its rolling log file without
# the compose stack mounting a host volume.
RUN mkdir -p /var/log/asap
COPY --from=build /src/ASAPQuery-backend/target/release/data_plane \
    /usr/local/bin/asap-query-backend
# Phase-9 single-binary refactor (2026-05): the controller crate
# moved into ASAPQuery-backend, so the control-plane binary now
# ships from this image too. base.yml's `controller:` service points
# at `asap/query-backend:dev` and overrides ENTRYPOINT to
# `/usr/local/bin/controller`.
COPY --from=build /src/ASAPQuery-backend/target/release/control_plane \
    /usr/local/bin/controller

ENV RUST_LOG=info \
    ASAP_BACKEND_PORT=9090 \
    ASAP_BACKEND_METRICS_PORT=9465

EXPOSE 9090 9465 8080 4320 4321
ENTRYPOINT ["/usr/local/bin/asap-query-backend"]

# Full sketchcol image — the ASAP-patched OpenTelemetry Collector
# with DDSketch / KLL / HLL / CountSketch / CountMinSketch
# processors compiled in. This is the image the paper's B2
# (hand-tuned sketches) and B3 (full ASAP) baselines need.
#
# ## Build model: host-build, container-ship
#
# The patched collector depends on the private
# `ProjectASAP/sketchlib-go` module. Running the full OCB build
# inside Docker fights with go's private-module resolution (go
# mod tidy hits sum.golang.org for sketchlib-go even with a
# replace directive in the build config). Rather than thread
# SSH keys + GOPRIVATE + replace-injection through BuildKit,
# this Dockerfile is just a runtime stage that wraps the
# pre-built binary.
#
# ## Prereqs (run once on the build host)
#
# 1. Initialize the upstream submodules so the patches can be
#    applied on top:
#
#      git submodule update --init --recursive \
#        opentelemetry-collector \
#        opentelemetry-collector-contrib \
#        opentelemetry-proto
#
# 2. Check out `ProjectASAP/sketchlib-go` on the branch that
#    exposes `SerializeMsgpack` (today:
#    `feat/sketch-msgpack-serialize`) and note its path.
#
# 3. Add a just-in-time replace to the OCB manifest pointing at
#    that checkout (don't commit it):
#
#      echo "  - github.com/ProjectASAP/sketchlib-go => /path/to/sketchlib-go" \
#        >> opentelemetry-collector-contrib-patch/cmd/sketchcollector/builder-config.yaml
#
# 4. Build the collector:
#
#      GOPRIVATE='github.com/ProjectASAP/*' \
#        bash build_sketchcollector.sh --skip-patches
#
#    Binary lands at
#    `opentelemetry-collector-contrib-patch/cmd/sketchcollector/sketchcollector`.
#
# 5. Build this image (the COPY below expects the binary to be
#    present in the build context):
#
#      docker build -f deploy/docker/Dockerfile.sketchcol \
#        -t asap/sketchcol:dev .
#
# For a stock-otel fallback that skips all of this, use
# `Dockerfile.sketchcol-stock` — covers B0 + B1 baselines only.

FROM debian:bookworm-slim
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY opentelemetry-collector-contrib-patch/cmd/sketchcollector/sketchcollector \
    /usr/local/bin/sketchcollector

EXPOSE 4317 4318 8888 9464
ENTRYPOINT ["/usr/local/bin/sketchcollector"]
CMD ["--config=/etc/otel/config.yaml"]
